{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://frozenlettuce38.github.io/contexts/work-provenance/handoff-snapshot-event/v1.jsonld",
      "jsonSchema": "https://frozenlettuce38.github.io/contexts/work-provenance/handoff-snapshot-event/v1.json"
    },
    "merklizationRootPosition": "Index"
  },
  "type": "object",
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string", "const": "HandoffSnapshot" },
        "previousEvent": {
          "type": "object",
          "properties": {
            "vcId": { "type": "string" },
            "vcHash": { "type": "string" }
          }
        },
        "completedRole": {
          "type": "string",
          "enum": ["CharacterDesign", "StoryWriting", "PromptEngineering", "Coloring", "Composition", "Mixing", "VoiceActing"]
        },
        "handoffTo": { "type": "string", "title": "Next contributor's DID" },
        "nextRole": {
          "type": "string",
          "enum": ["CharacterDesign", "StoryWriting", "PromptEngineering", "Coloring", "Composition", "Mixing", "VoiceActing"]
        },
        "editLogRoot": { "type": "string" },
        "contentHash": { "type": "string" },
        "storageRef": { "type": "string" }
      },
      "required": ["id", "eventType", "previousEvent", "completedRole", "handoffTo", "nextRole", "editLogRoot", "contentHash", "storageRef"]
    }
  }
}
