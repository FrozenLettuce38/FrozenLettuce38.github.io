{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://frozenlettuce38.github.io/contexts/work-provenance/handoff-event/v2.jsonld",
      "jsonSchema": "https://frozenlettuce38.github.io/contexts/work-provenance/handoff-event/v2.json"
    },
    "merklizationRootPosition": "Index"
  },
  "type": "object",
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "title": "Work DID (did:key)" },
        "eventType": { "type": "string", "const": "Handoff" },
        "previousEvent": {
          "type": "object",
          "properties": {
            "vcId": { "type": "string" },
            "vcHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "required": ["vcId", "vcHash"]
        },
        "handoffTo": { "type": "string", "title": "Next contributor's DID", "pattern": "^did:" },
        "nextRole": {
          "type": "string",
          "enum": ["CharacterDesign", "StoryWriting", "PromptEngineering", "Coloring", "Composition", "Mixing", "VoiceActing", "Rough", "LineArt", "Finishing"]
        }
      },
      "required": ["id", "eventType", "previousEvent", "handoffTo", "nextRole"]
    }
  }
}
