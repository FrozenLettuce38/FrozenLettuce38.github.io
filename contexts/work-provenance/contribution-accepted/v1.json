{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$metadata": {
    "uris": {
      "jsonLdContext": "https://frozenlettuce38.github.io/contexts/work-provenance/contribution-accepted/v1.jsonld",
      "jsonSchema": "https://frozenlettuce38.github.io/contexts/work-provenance/contribution-accepted/v1.json"
    },
    "merklizationRootPosition": "Index"
  },
  "type": "object",
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "title": "Work DID (did:key)" },
        "eventType": { "type": "string", "const": "ContributionAccepted" },
        "declaration": {
          "type": "object",
          "title": "The ContributionDeclared VC being accepted",
          "properties": {
            "vcId": { "type": "string" },
            "vcHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "required": ["vcId", "vcHash"]
        }
      },
      "required": ["id", "eventType", "declaration"]
    }
  }
}
